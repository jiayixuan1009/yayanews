{
  "name": "yayanews",
  "version": "1.2.0",
  "private": true,
  "engines": {
    "node": ">=18.17.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "infra/*"
  ],
  "scripts": {
    "setup": "npm install && node infra/scripts/setup-python.mjs",
    "setup:python": "node infra/scripts/setup-python.mjs",
    "dev": "npm run build:packages && concurrently \"npm run dev -w @yayanews/web\" \"npm run dev -w @yayanews/admin\" \"npm run dev -w @yayanews/ws-server\" \"npm run dev -w @yayanews/pipeline\"",
    "clean:build": "node scripts/clean-build-artifacts.mjs",
    "build:packages": "npm run build -w @yayanews/logger && npm run build -w @yayanews/database",
    "build:web": "npm run build:packages && npm run build -w @yayanews/web",
    "build:admin": "npm run build:packages && npm run build -w @yayanews/admin",
    "build": "npm run build:packages && npm run build -w @yayanews/ws-server && npm run build -w @yayanews/web && npm run build -w @yayanews/admin && node infra/scripts/copy-standalone.mjs",
    "build:fresh": "npm run clean:build && npm run build",
    "start": "npm run start -w @yayanews/web",
    "lint": "npm run lint -w @yayanews/web && npm run lint -w @yayanews/admin",
    "db:init": "dotenv -e .env -- npm run db:init -w @yayanews/database",
    "db:seed": "dotenv -e .env -- npm run db:seed -w @yayanews/database",
    "db:migrate": "dotenv -e .env -- npm run db:migrate -w @yayanews/database",
    "db:migrate:status": "dotenv -e .env -- npm run db:migrate:status -w @yayanews/database",
    "db:restore:cloud-seed": "dotenv -e .env -- psql -v ON_ERROR_STOP=1 -f data/cloud_seed.sql",
    "db:report:seed": "node scripts/report-seed-en-stats.mjs",
    "db:restore:recommended": "node scripts/restore-recommended.mjs",
    "db:gap-report": "node scripts/content-gap-report.mjs",
    "pipeline:translate-en": "node scripts/pipeline-translate-en.mjs",
    "pipeline:translate-en:all": "node scripts/pipeline-translate-en.mjs --until-done",
    "ops:health": "node scripts/ops/health-report.mjs",
    "ops:public-health": "node scripts/ops/public-health.mjs",
    "verify:seo": "node scripts/verify/seo-metadata-check.mjs"
  },
  "dependencies": {
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.37",
    "concurrently": "^9.2.1",
    "dotenv-cli": "^11.0.0",
    "next": "15.5.18"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "brace-expansion": "5.0.6"
    },
    "dompurify": "3.4.8",
    "next": "15.5.18",
    "postcss": "8.5.15",
    "qs": "6.15.2",
    "shell-quote": "1.8.4"
  }
}
