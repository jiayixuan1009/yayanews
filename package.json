{
  "name": "yayanews",
  "version": "1.2.0",
  "private": true,
  "engines": {
    "node": ">=20.19.0 <20.20.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "infra/*"
  ],
  "scripts": {
    "preinstall": "node scripts/verify/check-node-version.mjs",
    "check:node": "node scripts/verify/check-node-version.mjs",
    "setup": "npm run check:node && npm install && node infra/scripts/setup-python.mjs",
    "setup:python": "node infra/scripts/setup-python.mjs",
    "dev": "npm run check:node && npm run build:packages && concurrently \"npm run dev -w @yayanews/web\" \"npm run dev -w @yayanews/admin\" \"npm run dev -w @yayanews/ws-server\" \"npm run dev -w @yayanews/pipeline\"",
    "clean:build": "node scripts/clean-build-artifacts.mjs",
    "build:packages": "npm run build -w @yayanews/logger && npm run build -w @yayanews/database",
    "build:web": "npm run check:node && npm run build:packages && node scripts/build-next-app.mjs @yayanews/web --no-standalone --dist-dir .next-validation",
    "build:admin": "npm run check:node && npm run build:packages && node scripts/build-next-app.mjs @yayanews/admin --no-standalone --dist-dir .next-validation",
    "build:admin:standalone": "npm run check:node && npm run build:packages && node scripts/build-next-app.mjs @yayanews/admin --standalone",
    "build": "npm run check:node && npm run build:packages && npm run build -w @yayanews/ws-server && npm run build -w @yayanews/web && node scripts/build-next-app.mjs @yayanews/admin --standalone && node infra/scripts/copy-standalone.mjs",
    "build:fresh": "npm run clean:build && npm run build",
    "start": "npm run check:node && npm run start -w @yayanews/web",
    "lint": "npm run lint -w @yayanews/web && npm run lint -w @yayanews/admin",
    "db:init": "dotenv -e .env -- npm run db:init -w @yayanews/database",
    "db:seed": "dotenv -e .env -- npm run db:seed -w @yayanews/database",
    "db:migrate": "dotenv -e .env -- npm run db:migrate -w @yayanews/database",
    "db:migrate:status": "dotenv -e .env -- npm run db:migrate:status -w @yayanews/database",
    "db:migrate:repair-known-drift": "dotenv -e .env -- node packages/database/scripts/repair-known-migration-drift.mjs",
    "db:restore:cloud-seed": "dotenv -e .env -- psql -v ON_ERROR_STOP=1 -f data/cloud_seed.sql",
    "db:report:seed": "node scripts/report-seed-en-stats.mjs",
    "db:restore:recommended": "node scripts/restore-recommended.mjs",
    "db:gap-report": "node scripts/content-gap-report.mjs",
    "db:backfill:en-slugs": "node scripts/maintenance/backfill-english-article-slugs.mjs",
    "db:backfill:review-metadata": "node scripts/maintenance/backfill-review-metadata.mjs",
    "pipeline:translate-en": "node scripts/pipeline-translate-en.mjs",
    "pipeline:translate-en:all": "node scripts/pipeline-translate-en.mjs --until-done",
    "ops:health": "node scripts/ops/health-report.mjs",
    "ops:public-health": "node scripts/ops/public-health.mjs",
    "loop:import-gsc": "node scripts/loop/import-gsc-performance.mjs",
    "loop:score": "node scripts/loop/score-opportunities.mjs",
    "loop:execute": "node scripts/loop/execute-actions.mjs",
    "loop:report": "node scripts/loop/report-loop-results.mjs",
    "loop:fetch-gsc": "node scripts/loop/fetch-gsc-performance.mjs",
    "loop:import-ga4": "node scripts/loop/import-ga4-traffic.mjs",
    "loop:gsc": "node scripts/loop/run-gsc-api-loop.mjs",
    "loop:import-feedback": "node scripts/loop/import-feedback-events.mjs",
    "loop:latest": "node scripts/loop/run-latest-export.mjs",
    "loop:run": "node scripts/loop/run-loop.mjs",
    "verify:google-apis": "node scripts/verify/google-api-connections.mjs",
    "verify:news-sitemap-policy": "node scripts/verify/news-sitemap-policy.mjs",
    "verify:article-metadata-title": "node scripts/verify/article-metadata-title.mjs",
    "verify:cloudflare-real-ip": "node scripts/verify/cloudflare-real-ip-config.mjs",
    "verify:nginx-traffic": "node scripts/verify/analyze-nginx-traffic.mjs",
    "verify:gsc-export": "npm run check:node && node scripts/verify/analyze-gsc-export.mjs",
    "verify:article-slugs": "npm run check:node && node scripts/verify/check-article-slug-policy.mjs",
    "verify:redirects": "npm run check:node && node scripts/verify/redirect-regression.mjs",
    "verify:seo": "npm run check:node && node scripts/verify/seo-metadata-check.mjs",
    "verify:tag-quality": "npm run check:node && node scripts/verify/tag-quality-audit.mjs"
  },
  "dependencies": {
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.37",
    "concurrently": "^9.2.1",
    "dotenv-cli": "^11.0.0",
    "next": "15.5.18"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "brace-expansion": "5.0.6"
    },
    "dompurify": "3.4.8",
    "next": "15.5.18",
    "postcss": "8.5.15",
    "qs": "6.15.2",
    "shell-quote": "1.8.4"
  }
}
